     --warehouse-prefix "s3://lakesoul-test-bucket" \
       --endpoint  "http://localhost:31099" \
       --s3-bucket  "lakesoul-test-bucket" \
       --s3-access-key "rustfsadmin" \
       --s3-secret-key "rustfsadmin" tpch-gen -p "s3://lakesoul-test-bucket" --scale-factor 0.1 -n 8

copy level=log_level:
    RUST_LOG={{ level }} cargo run --release --bin lakesoul-console -- --worker-threads 16 --file copy.sql

cross:
    cross build --target x86_64-unknown-linux-gnu --release --package lakesoul-io-c -F hdfs
    cross build --target x86_64-unknown-linux-gnu --release  --package lakesoul-metadata-c --all-features
    cp target/x86_64-unknown-linux-gnu/release/lib*.so target/release
    cd .. && mvn install -pl lakesoul-flink -Pcross-build -am -DskipTests

# Create the test_tables fixtures: 1M synthetic rows + full TPC-H SF 0.1.
test-tables:
    ./script/test_tables.sh

# Larger fixtures: 10M synthetic rows + full TPC-H SF 1.
test-tables-large:
    ROWS=10000000 SF=1 ./script/test_tables.sh

# Same fixtures on S3 (RustFS); the warehouse prefix overrides the LOCATION clauses.
test-tables-s3:
    ./script/test_tables.sh \
      --warehouse-prefix "s3://lakesoul-test-bucket/test-tables" \
      --endpoint "http://localhost:9000" \
      --s3-bucket "lakesoul-test-bucket" \
      --s3-access-key "rustfsadmin" \
      --s3-secret-key "rustfsadmin"

clean-test-tables: clean-meta
    rm -rf /tmp/lakesoul/test_tables

clean-test-tables-s3: clean-meta
    mc rm -r --force dev/lakesoul-test-bucket/test-tables

pg:
    mkdir -p {{ log_dir }}
    RUST_LOG=info cargo run -p postgres-lakesoul -- -p 6543 \
     --warehouse-prefix "s3://lakesoul-test-bucket" \
     --endpoint "http://localhost:9000" \
     --s3-bucket "lakesoul-test-bucket" \
     --s3-access-key "rustfsadmin" \
     --s3-secret-key "rustfsadmin" \
     --distributed-workers http://127.0.0.1:50051,http://127.0.0.1:50052 2>&1 | tee -a {{ log_dir }}/postgres-lakesoul.pg.log
