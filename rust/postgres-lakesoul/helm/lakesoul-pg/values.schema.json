{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "coordinator": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "enum": [1],
          "description": "Phase one has no coordinator leader election."
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subscriptions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["runner", "coordinator"]
        },
        "runner": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "enum": [1],
              "description": "The subscription lease is not yet an HA protocol."
            }
          }
        }
      }
    },
    "warehouse": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["s3", "pvc"]
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "jwt": {"type": "boolean"},
        "rbac": {"type": "boolean"}
      },
      "if": {
        "properties": {
          "rbac": {"const": true}
        }
      },
      "then": {
        "properties": {
          "jwt": {"const": true}
        }
      }
    }
  }
}
