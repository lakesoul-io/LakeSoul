query III
SELECT CAST(-32768 AS SMALLINT), CAST(2147483647 AS INTEGER), CAST(9223372036854775807 AS BIGINT)
----
-32768 2147483647 9223372036854775807

query II
SELECT CAST(-7 AS INTEGER) / CAST(2 AS INTEGER), CAST(-7 AS INTEGER) % CAST(2 AS INTEGER)
----
-3 -1

query RRR
SELECT CAST(0 AS DECIMAL(12, 2)), CAST(-12.50 AS DECIMAL(12, 2)), CAST(NULL AS DECIMAL(12, 2))
----
0.00 -12.50 NULL

query R
SELECT CAST(2.50 AS DECIMAL(12, 2)) + CAST(1.25 AS DECIMAL(12, 2))
----
3.75

# Exactly representable floats; this runner does not use numeric tolerances.
query RR
SELECT CAST(1.5 AS REAL), CAST(2.25 AS DOUBLE PRECISION)
----
1.5 2.25

query TT
SELECT DATE '2024-02-29', TIMESTAMP '2024-02-29 12:34:56.123456'
----
2024-02-29 "2024-02-29 12:34:56.123456"

query TTTII
SELECT CAST(ARRAY[] AS INTEGER[]), CAST(NULL AS INTEGER[]), CAST(ARRAY[1, NULL, 3] AS INTEGER[]), (CAST(ARRAY[1, 2, 3] AS INTEGER[]))[1], (CAST(ARRAY[1, 2, 3] AS INTEGER[]))[9]
----
{} NULL {1,NULL,3} 1 NULL
