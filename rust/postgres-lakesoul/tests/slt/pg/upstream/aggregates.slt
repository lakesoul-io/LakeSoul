# PostgreSQL REL_18_6 @ 724edf9bde9d356724ad384a2e196edc3c9f80f7
# Original SQL and upstream answers; rowsort compares whole rows as a multiset.

# upstream-sql: sql/aggregates.sql:712-713
# upstream-expected: expected/aggregates.out:1827-1832
query T rowsort
select array_agg(a order by b)
  from (values (1,4),(2,3),(3,1),(4,2)) v(a,b);
----
{3,4,2,1}

# upstream-sql: sql/aggregates.sql:714-715
# upstream-expected: expected/aggregates.out:1834-1839
query T rowsort
select array_agg(a order by a)
  from (values (1,4),(2,3),(3,1),(4,2)) v(a,b);
----
{1,2,3,4}

# upstream-sql: sql/aggregates.sql:716-717
# upstream-expected: expected/aggregates.out:1841-1846
query T rowsort
select array_agg(a order by a desc)
  from (values (1,4),(2,3),(3,1),(4,2)) v(a,b);
----
{4,3,2,1}

# upstream-sql: sql/aggregates.sql:718-719
# upstream-expected: expected/aggregates.out:1848-1853
query T rowsort
select array_agg(b order by a desc)
  from (values (1,4),(2,3),(3,1),(4,2)) v(a,b);
----
{2,1,3,4}

# upstream-sql: sql/aggregates.sql:723-724
# upstream-expected: expected/aggregates.out:1862-1867
query T rowsort
select array_agg(distinct a order by a)
  from (values (1),(2),(1),(3),(null),(2)) v(a);
----
{1,2,3,NULL}

# upstream-sql: sql/aggregates.sql:725-726
# upstream-expected: expected/aggregates.out:1869-1874
query T rowsort
select array_agg(distinct a order by a desc)
  from (values (1),(2),(1),(3),(null),(2)) v(a);
----
{NULL,3,2,1}

# upstream-sql: sql/aggregates.sql:727-728
# upstream-expected: expected/aggregates.out:1876-1881
query T rowsort
select array_agg(distinct a order by a desc nulls last)
  from (values (1),(2),(1),(3),(null),(2)) v(a);
----
{3,2,1,NULL}

# upstream-sql: sql/aggregates.sql:964-964
# upstream-expected: expected/aggregates.out:2389-2393
query I rowsort
select any_value(v) filter (where v > 2) from (values (1), (2), (3)) as v (v);
----
3

# upstream-sql: sql/aggregates.sql:967-969
# upstream-expected: expected/aggregates.out:2396-2403
query I rowsort
select (select count(*)
        from (values (1)) t0(inner_c))
from (values (2),(3)) t1(outer_c); -- inner query is aggregation query
----
1
1
