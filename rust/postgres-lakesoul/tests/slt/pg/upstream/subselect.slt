# upstream-sql: sql/subselect.sql:5-5
# upstream-expected: expected/subselect.out:4-8
query I rowsort
SELECT 1 AS one WHERE 1 IN (SELECT 1);
----
1

# upstream-sql: sql/subselect.sql:7-7
# upstream-expected: expected/subselect.out:10-13
query I rowsort
SELECT 1 AS zero WHERE 1 NOT IN (SELECT 1);
----

# upstream-sql: sql/subselect.sql:9-9
