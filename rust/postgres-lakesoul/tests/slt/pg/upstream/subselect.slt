query I rowsort
SELECT 1 AS zero WHERE 1 IN (SELECT 2);
----

# upstream-sql: sql/subselect.sql:13-13
# upstream-expected: expected/subselect.out:21-25
query I rowsort
SELECT * FROM (SELECT 1 AS x) ss;
----
1

# upstream-sql: sql/subselect.sql:14-14
# upstream-expected: expected/subselect.out:27-31
query I rowsort
SELECT * FROM ((SELECT 1 AS x)) ss;
----
1

# upstream-sql: sql/subselect.sql:16-16
# upstream-expected: expected/subselect.out:33-37
query II rowsort
SELECT * FROM ((SELECT 1 AS x)), ((SELECT * FROM ((SELECT 2 AS y))));
----
