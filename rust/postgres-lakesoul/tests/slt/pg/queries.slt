query IIII
SELECT id, CAST(ROW_NUMBER() OVER (ORDER BY id) AS BIGINT), CAST(RANK() OVER (ORDER BY v) AS BIGINT), SUM(v) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM (VALUES (1, 10), (2, 10), (3, 20)) AS t(id, v) ORDER BY id
----
1 1 1 10
2 2 1 20
3 3 3 40
