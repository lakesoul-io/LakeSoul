dd NULL NULL 33
ee NULL 42 NULL

# upstream-sql: sql/join.sql:262-266
# upstream-expected: expected/join.out:1979-1990
query TII rowsort
SELECT * FROM
(SELECT * FROM t2) as s2
FULL JOIN
(SELECT * FROM t3) s3
USING (name);
----
bb 12 13
cc 22 23
dd NULL 33
ee 42 NULL

# upstream-sql: sql/join.sql:280-283
# upstream-expected: expected/join.out:2015-2025
query TIIII rowsort
SELECT * FROM
(SELECT name, n as s2_n, 2 as s2_2 FROM t2) as s2
NATURAL FULL JOIN
(SELECT name, n as s3_n, 3 as s3_2 FROM t3) s3;
----
bb 12 2 13 3
cc 22 2 23 3
dd NULL NULL 33 3
ee 42 2 NULL NULL

# upstream-sql: sql/join.sql:292-297
# upstream-expected: expected/join.out:2038-2050
query TIIIIII rowsort
SELECT * FROM
(SELECT name, n as s1_n, 1 as s1_1 FROM t1) as s1
NATURAL FULL JOIN
(SELECT name, n as s2_n, 2 as s2_2 FROM t2) as s2
NATURAL FULL JOIN
(SELECT name, n as s3_n, 3 as s3_2 FROM t3) s3;
----
bb 11 1 12 2 13 3
cc NULL NULL 22 2 23 3
dd NULL NULL NULL NULL 33 3
ee NULL NULL 42 2 NULL NULL

# upstream-sql: sql/join.sql:299-306
