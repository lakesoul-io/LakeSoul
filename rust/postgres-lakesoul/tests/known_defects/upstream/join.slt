    (SELECT name, n as s2_n FROM t2) as s2
    NATURAL FULL JOIN
    (SELECT name, n as s3_n FROM t3) as s3
  ) ss2;
----
bb 11 12 13
cc NULL 22 23
dd NULL NULL 33
ee NULL 42 NULL

# upstream-sql: sql/join.sql:308-315
# upstream-expected: expected/join.out:2068-2082
query TIIII rowsort
SELECT * FROM
(SELECT name, n as s1_n FROM t1) as s1
NATURAL FULL JOIN
