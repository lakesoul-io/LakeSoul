# PostgreSQL REL_18_6 @ 724edf9bde9d356724ad384a2e196edc3c9f80f7
# Original SQL and upstream answers; rowsort compares whole rows as a multiset.

# upstream-sql: sql/window.sql:157-158
# upstream-expected: expected/window.out:662-676
query RRR rowsort
select x, lag(x, 1) over (order by x), lead(x, 3) over (order by x)
from (select x::numeric as x from generate_series(1,10) x);
----
1 NULL 4
10 9 NULL
2 1 5
3 2 6
4 3 7
5 4 8
6 5 9
7 6 10
8 7 NULL
9 8 NULL

# upstream-sql: sql/window.sql:572-573
# upstream-expected: expected/window.out:2092-2099
query II rowsort
select x, last_value(x) over (order by x::smallint range between current row and 2147450884 following)
from generate_series(32764, 32766) x;
----
32764 32766
32765 32766
32766 32766

# upstream-sql: sql/window.sql:575-576
# upstream-expected: expected/window.out:2101-2108
query II rowsort
select x, last_value(x) over (order by x::smallint desc range between current row and 2147450885 following)
from generate_series(-32766, -32764) x;
----
-32764 -32766
-32765 -32766
-32766 -32766

# upstream-sql: sql/window.sql:578-579
# upstream-expected: expected/window.out:2110-2117
query II rowsort
select x, last_value(x) over (order by x range between current row and 4 following)
from generate_series(2147483644, 2147483646) x;
----
2147483644 2147483646
2147483645 2147483646
2147483646 2147483646

# upstream-sql: sql/window.sql:581-582
# upstream-expected: expected/window.out:2119-2126
query II rowsort
select x, last_value(x) over (order by x desc range between current row and 5 following)
from generate_series(-2147483646, -2147483644) x;
----
-2147483644 -2147483646
-2147483645 -2147483646
-2147483646 -2147483646

# upstream-sql: sql/window.sql:584-585
# upstream-expected: expected/window.out:2128-2135
query II rowsort
select x, last_value(x) over (order by x range between current row and 4 following)
from generate_series(9223372036854775804, 9223372036854775806) x;
----
9223372036854775804 9223372036854775806
9223372036854775805 9223372036854775806
9223372036854775806 9223372036854775806

# upstream-sql: sql/window.sql:587-588
# upstream-expected: expected/window.out:2137-2144
query II rowsort
select x, last_value(x) over (order by x desc range between current row and 5 following)
from generate_series(-9223372036854775806, -9223372036854775804) x;
----
-9223372036854775804 -9223372036854775806
-9223372036854775805 -9223372036854775806
-9223372036854775806 -9223372036854775806

# upstream-sql: sql/window.sql:2041-2043
# upstream-expected: expected/window.out:5623-5633
query ITTT rowsort
SELECT i, b, bool_and(b) OVER w, bool_or(b) OVER w
  FROM (VALUES (1,true), (2,true), (3,false), (4,false), (5,true)) v(i,b)
  WINDOW w AS (ORDER BY i ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING);
----
1 t t t
2 t f t
3 f f f
4 f f t
5 t t t
