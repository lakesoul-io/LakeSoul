1 2 3
2 2 2
2 3 4
3 3 3
3 4 5
6 7 8
8 9 NULL

# upstream-sql: sql/subselect.sql:70-73
# upstream-expected: expected/subselect.out:167-178
query IR rowsort
SELECT f1 AS "Correlated Field", f3 AS "Second Field"
  FROM SUBSELECT_TBL upper
  WHERE f1 IN
    (SELECT f2 FROM SUBSELECT_TBL WHERE CAST(upper.f2 AS float) = f3);
----
1 1
2 2
2 4
3 3
3 5
