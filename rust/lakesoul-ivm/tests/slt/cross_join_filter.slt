# A filtered CROSS JOIN: rows entering or leaving either side's filter add or
# retract their pairs.

statement ok
/*ivm-append __SRC1__: id=1,lv=keep,op=insert; id=2,lv=skip,op=insert*/

statement ok
/*ivm-append __SRC2__: rid=10,rv=100,op=insert; rid=11,rv=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC1__ l CROSS JOIN __SRC2__ r WHERE l.lv <> 'skip' AND r.rv > 10

statement ok
/*ivm-expect-action bootstrap*/

query TIII rowsort
