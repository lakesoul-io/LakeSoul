# A HAVING definition change rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT g, SUM(v), MIN(v), MAX(v), COUNT(*) FROM __SRC__ GROUP BY g HAVING MIN(v) > 5

statement ok
/*ivm-expect-action rebuild*/

