# HAVING over an append-only changelog: CDC markers retract through the view.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=5,op=insert; k=3,g=b,v=1,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY g HAVING SUM(v) > 12

statement ok
/*ivm-expect-action bootstrap*/

query IT rowsort
SELECT g, sum_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 15

# A delete marker retracts the contribution; a new group qualifies.
statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=delete; k=4,g=b,v=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY g HAVING SUM(v) > 12

statement ok
/*ivm-expect-action incremental*/

query IT rowsort
SELECT g, sum_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
b 21

# An update pair retracts the old value and adds the new one.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=5,op=update_before; k=2,g=a,v=20,op=update_after*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY g HAVING SUM(v) > 12

statement ok
/*ivm-expect-action incremental*/

query IT rowsort
SELECT g, sum_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 20
b 21
