# A wide lookup LEFT JOIN materializes several columns per side; an
# unmatched fact row keeps NULLs on the right side.

statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=L1,ln=1,op=insert; id=2,jk=b,lv=L2,ln=2,op=insert*/

statement ok
/*ivm-append __SRC2__: jk=a,rv=10,rn=100,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, l.ln, r.rv, r.rn FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk

statement ok
/*ivm-expect-action bootstrap*/

query TTIIII rowsort
SELECT jk, lv, ln, rv, rn, id FROM __MV__
----
a L1 1 10 100 1
b L2 2 NULL NULL 2

