# An inner join with a non-equality condition over the payloads: only the
# pairs satisfying it are materialized, and a payload change can add or
# retract pairs.

statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=5,op=insert; id=2,jk=a,lv=50,op=insert*/

statement ok
/*ivm-append __SRC2__: rid=10,jk=a,rv=10,op=insert; rid=11,jk=a,rv=100,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk AND l.lv < r.rv

statement ok
/*ivm-expect-action bootstrap*/

query IIII rowsort
SELECT "__left_pk_id", left_value, right_value, "__right_pk_rid" FROM __MV__
----
1 5 10 10
1 5 100 11
2 50 100 11

# A left payload change flips some pairs.
statement ok
/*ivm-append __SRC__: id=2,jk=a,lv=1,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk AND l.lv < r.rv

statement ok
/*ivm-expect-action incremental*/

query IIII rowsort
SELECT "__left_pk_id", left_value, right_value, "__right_pk_rid" FROM __MV__
----
1 5 10 10
1 5 100 11
2 1 10 10
2 1 100 11

# A right payload change retracts its failing pairs.
statement ok
/*ivm-append __SRC2__: rid=10,jk=a,rv=0,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk AND l.lv < r.rv

statement ok
/*ivm-expect-action incremental*/

query IIII rowsort
SELECT "__left_pk_id", left_value, right_value, "__right_pk_rid" FROM __MV__
----
1 5 100 11
2 1 100 11

# A delete removes the row's pairs.
statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=5,op=delete*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk AND l.lv < r.rv

statement ok
/*ivm-expect-action incremental*/

query IIII rowsort
SELECT "__left_pk_id", left_value, right_value, "__right_pk_rid" FROM __MV__
----
2 1 100 11

# A changed condition rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk AND l.lv > r.rv

statement ok
/*ivm-expect-action rebuild*/

query IIII rowsort
SELECT "__left_pk_id", left_value, right_value, "__right_pk_rid" FROM __MV__
----
2 1 0 10
