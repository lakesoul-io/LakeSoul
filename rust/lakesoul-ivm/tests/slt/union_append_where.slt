# UNION ALL of append-only sources with per-branch predicates.

statement ok
/*ivm-append __SRC1__: k=1,g=a,v=10,op=insert*/

statement ok
/*ivm-append __SRC2__: k=2,g=b,v=3,op=insert*/

statement ok
INSERT INTO __MV__ SELECT * FROM __SRC1__ WHERE v > 5 UNION ALL SELECT * FROM __SRC2__ WHERE v > 5

statement ok
/*ivm-expect-action bootstrap*/

query ITII rowsort
SELECT k, g, v, __ivm_source FROM __MV__
----
1 a 10 0

# Every appended row is filtered by its own branch predicate.
statement ok
/*ivm-append __SRC1__: k=2,g=a,v=2,op=insert; k=3,g=a,v=8,op=insert*/

statement ok
/*ivm-append __SRC2__: k=3,g=b,v=9,op=insert*/

statement ok
INSERT INTO __MV__ SELECT * FROM __SRC1__ WHERE v > 5 UNION ALL SELECT * FROM __SRC2__ WHERE v > 5

statement ok
/*ivm-expect-action incremental*/

query ITII rowsort
SELECT k, g, v, __ivm_source FROM __MV__
----
1 a 10 0
3 a 8 0
3 b 9 1
