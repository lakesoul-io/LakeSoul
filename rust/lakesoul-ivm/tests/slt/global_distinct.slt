# Global COUNT(DISTINCT v) (then SUM(DISTINCT v), same schema).

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=10,op=insert; k=3,g=b,v=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT COUNT(DISTINCT v) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query I rowsort
SELECT "value" FROM __MV__
----
2

# Duplicate values do not move the count.
statement ok
/*ivm-append __SRC__: k=4,g=b,v=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT COUNT(DISTINCT v) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query I rowsort
SELECT "value" FROM __MV__
----
2

# Deleting every copy of a value drops the count.
statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=delete; k=2,g=a,v=10,op=delete*/

statement ok
INSERT INTO __MV__ SELECT COUNT(DISTINCT v) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query I rowsort
SELECT "value" FROM __MV__
----
1

# A filtered definition rebuilds the view with the same schema.
statement ok
/*ivm-append __SRC__: k=5,g=c,v=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT COUNT(DISTINCT v) FROM __SRC__ WHERE v > 10

statement ok
/*ivm-expect-action rebuild*/

query I rowsort
SELECT "value" FROM __MV__
----
1
