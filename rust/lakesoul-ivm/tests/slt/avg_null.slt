# AVG ignores NULL values; an all-NULL group averages to NULL.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=null,op=insert; k=3,g=b,v=null,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, AVG(v) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action bootstrap*/

query IR rowsort
SELECT g, avg_v FROM __MV__
----
a 10.0
b NULL

