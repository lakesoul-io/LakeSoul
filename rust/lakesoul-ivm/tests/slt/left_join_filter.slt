# A filtered pair-keyed LEFT JOIN: the fact rows leaving or entering the
# filter keep or lose their matches (or their NULL-padded pair).

statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=keep,op=insert; id=2,jk=b,lv=skip,op=insert*/

statement ok
/*ivm-append __SRC2__: rid=10,jk=a,rv=100,op=insert; rid=11,jk=c,rv=101,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'skip'

statement ok
/*ivm-expect-action bootstrap*/

query ITTII rowsort
SELECT "__left_pk_id", jk, left_value, right_value, "__right_pk_rid" FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 a keep 100 10

