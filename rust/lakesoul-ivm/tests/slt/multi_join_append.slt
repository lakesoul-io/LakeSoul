# An append-only three-way inner join: every refresh runs the
# inclusion-exclusion decomposition over the sources that changed, so the MV
# always equals the full join of the current sources.

statement ok
/*ivm-append __SRC1__: lk=a,lv=1; lk=b,lv=2*/

statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk

statement ok
/*ivm-expect-action bootstrap*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__

statement ok
/*ivm-append __SRC2__: mk=a,mv=10; mk=c,mv=30*/

statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk

statement ok
/*ivm-expect-action incremental*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__

# Rows arriving in different windows join the before state of the others.
statement ok
/*ivm-append __SRC3__: rk=a,rv=100; rk=c,rv=300*/

statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk

statement ok
/*ivm-expect-action incremental*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__
----
a 1 10 100

# A left and a middle delta in the same window.
statement ok
/*ivm-append __SRC1__: lk=c,lv=3*/

statement ok
/*ivm-append __SRC2__: mk=b,mv=20*/

statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk

statement ok
/*ivm-expect-action incremental*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__
----
a 1 10 100
c 3 30 300

# A middle and a right delta in one window are covered by the delta-times-
# delta term.
statement ok
/*ivm-append __SRC2__: mk=b,mv=21*/

statement ok
/*ivm-append __SRC3__: rk=b,rv=200*/

statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk

statement ok
/*ivm-expect-action incremental*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__
----
a 1 10 100
b 2 20 200
b 2 21 200
c 3 30 300

# A filtered definition rebuilds the view from the current sources.
statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk WHERE a.lv > 2

statement ok
/*ivm-expect-action rebuild*/

query TIII rowsort
SELECT lk, lv, mv, rv FROM __MV__
----
c 3 30 300
