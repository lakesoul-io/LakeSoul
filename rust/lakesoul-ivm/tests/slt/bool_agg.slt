# BOOL_AND over a Boolean column: NULL inputs are ignored, and the affected
# groups are recomputed.

statement ok
/*ivm-append __SRC__: k=1,g=a,flag=true,op=insert; k=2,g=a,flag=false,op=insert; k=3,g=b,flag=true,op=insert; k=4,g=b,flag=null,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, BOOL_AND(flag) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action bootstrap*/

query T? rowsort
SELECT g, bool_and_flag FROM __MV__
----
a false
b true

# An update flips the group.
statement ok
/*ivm-append __SRC__: k=2,g=a,flag=true,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, BOOL_AND(flag) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action incremental*/

query T? rowsort
SELECT g, bool_and_flag FROM __MV__
----
a true
b true

# A group whose rows all leave disappears.
statement ok
/*ivm-append __SRC__: k=1,g=a,flag=true,op=delete; k=2,g=a,flag=true,op=delete*/

statement ok
INSERT INTO __MV__ SELECT g, BOOL_AND(flag) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action incremental*/

query T? rowsort
SELECT g, bool_and_flag FROM __MV__
----
b true

# A filtered definition rebuilds the view.
statement ok
/*ivm-append __SRC__: k=5,g=c,flag=null,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, BOOL_AND(flag) FROM __SRC__ WHERE flag IS NOT NULL GROUP BY g

statement ok
/*ivm-expect-action rebuild*/

query T? rowsort
SELECT g, bool_and_flag FROM __MV__
----
b true
