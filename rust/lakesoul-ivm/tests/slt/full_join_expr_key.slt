# A full join with a computed key: the fact's `fk + 1` matches the
# dimension's `rv`, and unmatched rows of either side stay with NULLs.

statement ok
/*ivm-append __SRC__: id=1,fk=4,lv=L1,op=insert; id=2,fk=9,lv=L2,op=insert; id=3,fk=100,lv=L3,op=insert*/

statement ok
/*ivm-append __SRC2__: rk=7,rv=5,rn=R50,op=insert; rk=8,rv=10,rn=R100,op=insert; rk=9,rv=77,rn=R77,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, r.rn FROM __SRC__ l FULL JOIN __SRC2__ r ON l.fk + 1 = r.rv

statement ok
/*ivm-expect-action bootstrap*/

query TTIII rowsort
