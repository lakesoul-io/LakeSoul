# HAVING over the same expression maps onto sum_v.
statement ok
INSERT INTO __MV__ SELECT g, SUM(v * 2), AVG(v * 2) FROM __SRC__ GROUP BY g HAVING SUM(v * 2) > 5

statement ok
/*ivm-expect-action rebuild*/

query IIR rowsort
SELECT g, sum_v, avg_v FROM __MV__
----
a 14 7.0

