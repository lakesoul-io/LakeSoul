# An inner join with differently named keys (`ON f.jk = r.rk`): the MV keeps
# the left key names and both key columns stay out of the payloads.

statement ok
/*ivm-append __SRC__: id=1,jk=10,lv=100,op=insert; id=2,jk=20,lv=200,op=insert*/

statement ok
/*ivm-append __SRC2__: rid=5,rk=10,rv=1,op=insert; rid=6,rk=30,rv=3,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.jk, f.lv, r.rv FROM __SRC__ f JOIN __SRC2__ r ON f.jk = r.rk

statement ok
/*ivm-expect-action bootstrap*/

query IIIII rowsort
SELECT "__left_pk_id", "__right_pk_rid", jk, left_value, right_value FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 5 10 100 1

