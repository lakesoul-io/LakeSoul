# MEDIAN over groups, recomputed from the affected groups' current rows.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=20,op=insert; k=3,g=a,v=30,op=insert; k=4,g=b,v=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, MEDIAN(v) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action bootstrap*/

query TR rowsort
SELECT g, median_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 20.0
b 5.0

# New values move the median.
statement ok
/*ivm-append __SRC__: k=4,g=b,v=25,op=insert; k=5,g=b,v=15,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, MEDIAN(v) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action incremental*/

query TR rowsort
SELECT g, median_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 20.0
b 20.0

# A delete changes the middle value.
statement ok
/*ivm-append __SRC__: k=3,g=a,v=30,op=delete*/

statement ok
INSERT INTO __MV__ SELECT g, MEDIAN(v) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action incremental*/

query TR rowsort
SELECT g, median_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 15.0
b 20.0

# HAVING over the median.
statement ok
INSERT INTO __MV__ SELECT g, MEDIAN(v) FROM __SRC__ GROUP BY g HAVING MEDIAN(v) > 16

statement ok
/*ivm-expect-action rebuild*/

query TR rowsort
SELECT g, median_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
b 20.0

# A group re-enters the HAVING threshold.
statement ok
/*ivm-append __SRC__: k=6,g=a,v=25,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, MEDIAN(v) FROM __SRC__ GROUP BY g HAVING MEDIAN(v) > 16

statement ok
/*ivm-expect-action incremental*/

query TR rowsort
SELECT g, median_v FROM __MV__ WHERE "rowKinds" = 'insert'
