2 30 2 2
3 130 3 3
4 5 1 1

# A delete drops the row and shifts the following ranks.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=20,op=delete*/

statement ok
INSERT INTO __MV__ SELECT k, SUM(v) OVER w AS total, COUNT(*) OVER w AS n, ROW_NUMBER() OVER w AS rn FROM __SRC__ WINDOW w AS (PARTITION BY g ORDER BY v, k)

statement ok
