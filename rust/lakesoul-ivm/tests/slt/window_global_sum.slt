# A global running SUM frame.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert; k=4,g=b,v=1,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, SUM(v) OVER (ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, sum_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 21
2 4
3 11
4 1

