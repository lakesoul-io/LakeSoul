# A select-list correlated scalar COUNT: a key without rows counts zero.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=30,op=insert; k=3,g=b,v=20,op=insert*/

statement ok
/*ivm-append __DIM__: k=1,g=a,v=15,op=insert; k=1,g=a,v=25,op=insert; k=2,g=a,v=25,op=insert*/

statement ok
INSERT INTO __MV__ SELECT s.k, (SELECT count(u.v) FROM __DIM__ u WHERE u.k = s.k) AS c FROM __SRC__ s

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, c FROM __MV__
----
1 2
2 1
3 0

# A key losing its last row counts zero again.
statement ok
/*ivm-append __DIM__: k=2,g=a,v=25,op=delete*/

statement ok
INSERT INTO __MV__ SELECT s.k, (SELECT count(u.v) FROM __DIM__ u WHERE u.k = s.k) AS c FROM __SRC__ s

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, c FROM __MV__
----
1 2
2 0
3 0

# A key gaining rows counts them.
statement ok
/*ivm-append __DIM__: k=3,g=b,v=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT s.k, (SELECT count(u.v) FROM __DIM__ u WHERE u.k = s.k) AS c FROM __SRC__ s

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, c FROM __MV__
----
1 2
2 0
3 1
