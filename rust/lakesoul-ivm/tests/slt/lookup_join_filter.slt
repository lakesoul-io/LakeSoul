# A lookup LEFT JOIN with a left-side filter: the fact rows entering or
# leaving the filter appear or disappear with their dimension value.

statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=keep,op=insert; id=2,jk=b,lv=skip,op=insert*/

statement ok
/*ivm-append __SRC2__: jk=a,rv=10,op=insert; jk=b,rv=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'skip'

statement ok
/*ivm-expect-action bootstrap*/

query ITTI rowsort
SELECT id, jk, left_value, right_value FROM __MV__
----
1 a keep 10

# A fact row entering the filter appears with its dimension value.
statement ok
/*ivm-append __SRC__: id=2,jk=b,lv=ok,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'skip'

statement ok
/*ivm-expect-action incremental*/

query ITTI rowsort
SELECT id, jk, left_value, right_value FROM __MV__
----
1 a keep 10
2 b ok 20

# A fact row leaving the filter disappears.
statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=skip,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'skip'

statement ok
/*ivm-expect-action incremental*/

query ITTI rowsort
SELECT id, jk, left_value, right_value FROM __MV__
----
2 b ok 20

# A dimension update flows into the filtered fact rows.
statement ok
/*ivm-append __SRC2__: jk=b,rv=25,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'skip'

statement ok
/*ivm-expect-action incremental*/

query ITTI rowsort
SELECT id, jk, left_value, right_value FROM __MV__
----
2 b ok 25

# A changed filter rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l LEFT JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv <> 'none'

statement ok
/*ivm-expect-action rebuild*/

query ITTI rowsort
SELECT id, jk, left_value, right_value FROM __MV__
----
1 a skip 10
2 b ok 25
