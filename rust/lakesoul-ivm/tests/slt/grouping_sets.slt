# GROUP BY ROLLUP of one key: the detailed rows and the grand total share the
# MV, distinguished by the grouping index.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=30,op=insert; k=3,g=b,v=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY ROLLUP(g)

statement ok
/*ivm-expect-action bootstrap*/

query ITII rowsort
SELECT "__ivm_grouping", g, sum_v, count_v FROM __MV__
----
0 a 40 2
0 b 20 1
1 NULL 60 3

# An update moves both the detail and the total.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=40,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY ROLLUP(g)

statement ok
/*ivm-expect-action incremental*/

query ITII rowsort
SELECT "__ivm_grouping", g, sum_v, count_v FROM __MV__
----
0 a 50 2
0 b 20 1
1 NULL 70 3

# Deleting a whole group removes its detail row but not the total.
statement ok
/*ivm-append __SRC__: k=3,g=b,v=20,op=delete*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY ROLLUP(g)

statement ok
/*ivm-expect-action incremental*/

query ITII rowsort
SELECT "__ivm_grouping", g, sum_v, count_v FROM __MV__
----
0 a 50 2
1 NULL 50 2

# CUBE of one key is the same grouping set, so a data change keeps the
# definition and refreshes incrementally.
statement ok
/*ivm-append __SRC__: k=4,g=c,v=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(v), COUNT(*) FROM __SRC__ GROUP BY CUBE(g)

statement ok
/*ivm-expect-action incremental*/

query ITII rowsort
SELECT "__ivm_grouping", g, sum_v, count_v FROM __MV__
----
0 a 50 2
0 c 5 1
1 NULL 55 3
