# LAG(v) IGNORE NULLS skips NULL rows when counting the offset.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=null,op=insert; k=3,g=a,v=20,op=insert; k=4,g=a,v=null,op=insert; k=5,g=a,v=30,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, LAG(v) IGNORE NULLS OVER (PARTITION BY g ORDER BY v, k) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query ITI rowsort
SELECT g, k, lag_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 1 NULL
a 2 30
a 3 10
a 4 30
a 5 20

# An update to NULL still leaves the previous non-null value.
statement ok
