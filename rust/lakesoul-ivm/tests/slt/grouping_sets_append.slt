# GROUPING SETS over a plain append-only source (no changelog markers): the
# affected groups come from the delta and are recomputed from the current
# rows.  The key is a computed expression.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10; k=2,g=a,v=20*/

statement ok
INSERT INTO __MV__ SELECT v % 10 AS bucket, SUM(v), COUNT(*) FROM __SRC__ GROUP BY CUBE(bucket)

statement ok
/*ivm-expect-action bootstrap*/

query III rowsort
SELECT "__ivm_grouping", bucket, sum_v, count_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
0 0 30 2
1 NULL 30 2

# An append grows its bucket and the total.
statement ok
/*ivm-append __SRC__: k=3,g=b,v=5*/

statement ok
INSERT INTO __MV__ SELECT v % 10 AS bucket, SUM(v), COUNT(*) FROM __SRC__ GROUP BY CUBE(bucket)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT "__ivm_grouping", bucket, sum_v, count_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
0 0 30 2
0 5 5 1
1 NULL 35 3

# Another append lands in an existing bucket.
statement ok
/*ivm-append __SRC__: k=4,g=b,v=15*/

statement ok
INSERT INTO __MV__ SELECT v % 10 AS bucket, SUM(v), COUNT(*) FROM __SRC__ GROUP BY CUBE(bucket)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT "__ivm_grouping", bucket, sum_v, count_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
0 0 30 2
0 5 20 2
1 NULL 50 4

# A filtered definition rebuilds the view from the current rows.
statement ok
INSERT INTO __MV__ SELECT v % 10 AS bucket, SUM(v), COUNT(*) FROM __SRC__ WHERE v > 10 GROUP BY CUBE(bucket)

statement ok
/*ivm-expect-action rebuild*/

query III rowsort
SELECT "__ivm_grouping", bucket, sum_v, count_v FROM __MV__ WHERE "rowKinds" = 'insert'
----
0 0 20 1
0 5 15 1
1 NULL 35 2
