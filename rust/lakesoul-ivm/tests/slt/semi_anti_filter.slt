# Changed filters rebuild the view, and the ANTI variant keeps the fact rows
# without a match.
statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE f.x >= 0 AND NOT EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g AND d.rv > 0)

statement ok
/*ivm-expect-action rebuild*/

query III rowsort
