# EXISTS / NOT EXISTS / IN decorrelate into semi / anti joins maintained over
# the two keyed sources.

statement ok
/*ivm-append __SRC1__: k=1,g=10,x=1,op=insert; k=2,g=20,x=2,op=insert; k=3,g=10,x=3,op=insert*/

statement ok
/*ivm-append __SRC2__: rk=100,g=10,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action bootstrap*/

query III rowsort
SELECT k, g, x FROM __MV__
----
1 10 1
3 10 3

# A right row enables the matching left rows.
statement ok
/*ivm-append __SRC2__: rk=200,g=20,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
1 10 1
2 20 2
3 10 3

# A right delete disables its group.
statement ok
/*ivm-append __SRC2__: rk=100,g=10,op=delete*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
2 20 2

# A left row enters an enabled group and leaves it on update.
statement ok
/*ivm-append __SRC1__: k=4,g=20,x=4,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
2 20 2
4 20 4

statement ok
/*ivm-append __SRC1__: k=4,g=30,x=4,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
2 20 2

# The IN spelling is the same semi join.
statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE f.g IN (SELECT d.g FROM __SRC2__ d)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
2 20 2

# Switching to NOT EXISTS rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE NOT EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action rebuild*/

query III rowsort
SELECT k, g, x FROM __MV__
----
1 10 1
3 10 3
4 30 4

# A left insert inside the anti join definition.
statement ok
/*ivm-append __SRC1__: k=5,g=10,x=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE NOT EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

query III rowsort
SELECT k, g, x FROM __MV__
----
1 10 1
3 10 3
4 30 4
5 10 5

# A right row removes its group from the anti join.
statement ok
/*ivm-append __SRC2__: rk=300,g=10,op=insert*/

statement ok
INSERT INTO __MV__ SELECT f.k, f.g, f.x FROM __SRC1__ f WHERE NOT EXISTS (SELECT 1 FROM __SRC2__ d WHERE d.g = f.g)

statement ok
/*ivm-expect-action incremental*/

