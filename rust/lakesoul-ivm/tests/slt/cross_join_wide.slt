# A wide CROSS JOIN materializes several columns per side.

statement ok
/*ivm-append __SRC1__: id=1,lv=a,ln=1,op=insert*/

statement ok
/*ivm-append __SRC2__: rid=10,rv=100,rn=1000,op=insert; rid=11,rv=101,rn=1001,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, l.ln, r.rv, r.rn FROM __SRC1__ l CROSS JOIN __SRC2__ r

statement ok
/*ivm-expect-action bootstrap*/

query TIIIII rowsort
SELECT lv, ln, rv, rn, __left_pk_id, __right_pk_rid FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 1 100 1000 1 10
a 1 101 1001 1 11

# A new left row pairs with every right row.
statement ok
/*ivm-append __SRC1__: id=2,lv=b,ln=2,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, l.ln, r.rv, r.rn FROM __SRC1__ l CROSS JOIN __SRC2__ r

statement ok
/*ivm-expect-action incremental*/

query TIIIII rowsort
