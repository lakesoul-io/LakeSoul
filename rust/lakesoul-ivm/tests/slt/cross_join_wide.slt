a 1 100 1000 1 10
a 1 101 1001 1 11
b 2 100 1000 2 10
b 2 101 1001 2 11

# An update rewrites the pairs of the updated row.
statement ok
/*ivm-append __SRC2__: rid=10,rv=100,rn=2000,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.lv, l.ln, r.rv, r.rn FROM __SRC1__ l CROSS JOIN __SRC2__ r

statement ok
/*ivm-expect-action incremental*/

