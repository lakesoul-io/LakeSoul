# An inner keyed join with filters on both sides: the predicates are pushed
# below the join and rows entering or leaving them add or retract their pairs.

statement ok
/*ivm-append __SRC2__: rid=10,jk=a,rv=100,op=insert; rid=20,jk=b,rv=5,op=insert*/

statement ok
/*ivm-append __SRC__: id=1,jk=a,lv=5,op=insert; id=2,jk=b,lv=2,op=insert; id=3,jk=a,lv=0,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv > 1 AND r.rv > 10

statement ok
/*ivm-expect-action bootstrap*/

query TIII rowsort
SELECT jk, left_value, right_value, "__left_pk_id", "__right_pk_rid" FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 5 100 1 10

# A right row entering the filter adds its pairs.
statement ok
/*ivm-append __SRC2__: rid=20,jk=b,rv=15,op=insert*/

statement ok
INSERT INTO __MV__ SELECT l.jk, l.lv, r.rv FROM __SRC__ l JOIN __SRC2__ r ON l.jk = r.jk WHERE l.lv > 1 AND r.rv > 10

statement ok
/*ivm-expect-action incremental*/

query TIII rowsort
SELECT jk, left_value, right_value, "__left_pk_id", "__right_pk_rid" FROM __MV__ WHERE "rowKinds" = 'insert'
----
a 5 100 1 10
b 2 15 2 20

# A left row entering the filter adds its pair.
statement ok
/*ivm-append __SRC__: id=3,jk=a,lv=7,op=insert*/

statement ok
