# A top-k with a computed select list: the expression is materialized, and the
# statement may order by its alias.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=b,v=7,op=insert; k=4,g=b,v=1,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, v * 2 AS w FROM __SRC__ ORDER BY w DESC LIMIT 2

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, w FROM __MV__
----
1 20
3 14

