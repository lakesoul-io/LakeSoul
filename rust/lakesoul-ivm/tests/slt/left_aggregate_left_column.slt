# A select-list correlated scalar subquery combined with a row's own column:
# the computed output reads both, and the row column is not a select item.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=30,op=insert; k=3,g=b,v=20,op=insert*/

statement ok
/*ivm-append __DIM__: k=1,g=a,v=15,op=insert; k=1,g=a,v=25,op=insert; k=2,g=a,v=25,op=insert*/

statement ok
INSERT INTO __MV__ SELECT s.k, (s.v + (SELECT sum(u.v) FROM __DIM__ u WHERE u.k = s.k)) AS w FROM __SRC__ s

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, w FROM __MV__
----
1 50
2 55
3 NULL

