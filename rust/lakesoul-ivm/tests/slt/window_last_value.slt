# LAST_VALUE with a whole-partition frame.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, LAST_VALUE(v) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query ITI rowsort
SELECT g, k, last_value_v FROM __MV__
----
a 1 10
a 2 10
a 3 10

