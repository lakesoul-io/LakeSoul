# A global window without PARTITION BY.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert; k=4,g=b,v=1,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (ORDER BY v, k) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, row_number FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 4
2 2
3 3
4 1

