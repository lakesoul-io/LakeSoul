# A filtered definition rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT a.lk, a.lv, b.mv, c.rv FROM __SRC1__ a JOIN __SRC2__ b ON a.lk = b.mk JOIN __SRC3__ c ON b.mk = c.rk WHERE a.lv > 150

statement ok
/*ivm-expect-action rebuild*/

