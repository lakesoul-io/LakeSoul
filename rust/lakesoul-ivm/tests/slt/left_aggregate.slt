# A subquery filter rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT s.k, s.g, s.v, (SELECT avg(u.v) FROM __DIM__ u WHERE u.k = s.k AND u.v < 50) AS m FROM __SRC__ s

statement ok
/*ivm-expect-action rebuild*/

