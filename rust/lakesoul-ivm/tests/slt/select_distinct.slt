# A WHERE changes the definition: the view is rebuilt.
statement ok
INSERT INTO __MV__ SELECT DISTINCT g FROM __SRC__ WHERE v > 5

statement ok
/*ivm-expect-action rebuild*/

query I rowsort
SELECT g FROM __MV__ WHERE "rowKinds" = 'insert'
----
a

# A row enters the predicate and brings its value back.
