# FILTER (WHERE ...) on a SUM window.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert; k=4,g=b,v=1,op=insert; k=5,g=b,v=9,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, SUM(v) FILTER (WHERE v > 5) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query ITI rowsort
SELECT g, k, sum_v FROM __MV__
----
a 1 17
a 2 17
a 3 17
b 4 9
b 5 9

# A row entering the filter contributes to the whole partition.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=6,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, SUM(v) FILTER (WHERE v > 5) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query ITI rowsort
SELECT g, k, sum_v FROM __MV__
----
a 1 23
a 2 23
a 3 23
b 4 9
b 5 9

# Removing the only matching row of a partition yields a NULL sum.
statement ok
/*ivm-append __SRC__: k=5,g=b,v=9,op=delete*/

statement ok
INSERT INTO __MV__ SELECT k, g, SUM(v) FILTER (WHERE v > 5) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query ITI rowsort
