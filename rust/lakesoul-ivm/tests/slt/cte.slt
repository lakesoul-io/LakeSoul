# A WITH clause is inlined by the planner, so the view is maintained as the
# underlying shape (here a filtered SUM/COUNT).

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=b,v=7,op=insert*/

statement ok
INSERT INTO __MV__ WITH filtered AS (SELECT g, v FROM __SRC__ WHERE v > 5) SELECT g, SUM(v) FROM filtered GROUP BY g

statement ok
/*ivm-expect-action bootstrap*/

query TI rowsort
SELECT g, sum_v FROM __MV__
----
a 10
b 7

