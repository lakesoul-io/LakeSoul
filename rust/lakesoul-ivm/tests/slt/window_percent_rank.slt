# PERCENT_RANK over a partition with unique order keys.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=5,op=insert; k=2,g=a,v=1,op=insert; k=3,g=a,v=4,op=insert; k=4,g=a,v=2,op=insert; k=5,g=a,v=3,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, PERCENT_RANK() OVER (PARTITION BY g ORDER BY v, k) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query ITR rowsort
SELECT g, k, percent_rank FROM __MV__
----
a 1 1.0
a 2 0.0
a 3 0.75
a 4 0.25
a 5 0.5

# Moving a row to the end renumbers every rank.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=6,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, PERCENT_RANK() OVER (PARTITION BY g ORDER BY v, k) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query ITR rowsort
SELECT g, k, percent_rank FROM __MV__
----
a 1 0.75
a 2 1.0
a 3 0.5
a 4 0.0
a 5 0.25
