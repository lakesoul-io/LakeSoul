# FIRST_VALUE with a whole-partition frame.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, FIRST_VALUE(v) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__ WHERE v > 5

statement ok
/*ivm-expect-action bootstrap*/

query ITI rowsort
SELECT g, k, first_value_v FROM __MV__
----
a 1 7
a 3 7

# A row entering the predicate becomes the new first value.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=6,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, FIRST_VALUE(v) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__ WHERE v > 5

statement ok
/*ivm-expect-action incremental*/

query ITI rowsort
SELECT g, k, first_value_v FROM __MV__
----
a 1 6
a 2 6
a 3 6

# Deleting it restores the previous first value.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=6,op=delete*/

statement ok
INSERT INTO __MV__ SELECT k, g, FIRST_VALUE(v) OVER (PARTITION BY g ORDER BY v, k ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM __SRC__ WHERE v > 5

statement ok
/*ivm-expect-action incremental*/

query ITI rowsort
SELECT g, k, first_value_v FROM __MV__
----
a 1 7
a 3 7
