# An update that collides with another row shrinks the distinct sum.
statement ok
/*ivm-append __SRC__: k=3,g=a,v=10,op=insert; k=5,g=b,v=2,op=insert*/

statement ok
INSERT INTO __MV__ SELECT g, SUM(DISTINCT v) FROM __SRC__ GROUP BY g

statement ok
/*ivm-expect-action incremental*/

query IT rowsort
SELECT g, value FROM __MV__
----
a 10
b 9

# HAVING over the distinct sum.
statement ok
INSERT INTO __MV__ SELECT g, SUM(DISTINCT v) FROM __SRC__ GROUP BY g HAVING SUM(DISTINCT v) > 9

statement ok
/*ivm-expect-action rebuild*/

query IT rowsort
SELECT g, value FROM __MV__
----
a 10
