# SUM(DISTINCT v) through the SQL entry.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=10,op=insert; k=3,g=a,v=5,op=insert; k=4,g=b,v=7,op=insert*/

statement ok
