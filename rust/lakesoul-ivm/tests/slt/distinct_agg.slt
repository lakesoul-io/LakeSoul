# HAVING over the distinct count.
statement ok
INSERT INTO __MV__ SELECT g, COUNT(DISTINCT v) FROM __SRC__ GROUP BY g HAVING COUNT(DISTINCT v) > 1

statement ok
/*ivm-expect-action rebuild*/

query IT rowsort
SELECT g, value FROM __MV__
----
a 2

# The group drops below the threshold and leaves the view.
statement ok
