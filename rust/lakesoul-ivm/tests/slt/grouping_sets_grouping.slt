# A filtered definition rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT g, GROUPING(g) AS is_total, SUM(v), COUNT(*) FROM __SRC__ WHERE v > 10 GROUP BY ROLLUP(g)

statement ok
/*ivm-expect-action rebuild*/

query ITIII rowsort
SELECT "__ivm_grouping", g, is_total, sum_v, count_v FROM __MV__
