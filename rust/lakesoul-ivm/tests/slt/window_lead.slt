# LEAD resets affected partitions when rows move.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=3,op=insert; k=3,g=a,v=7,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, LEAD(v) OVER (PARTITION BY g ORDER BY v, k) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query ITI rowsort
SELECT g, k, lead_v FROM __MV__
----
a 1 NULL
a 2 7
a 3 10

