# A subquery filter rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT k, g, v FROM __SRC__ s WHERE v > (SELECT avg(u.v) FROM __DIM__ u WHERE u.k = s.k AND u.v < 50)

statement ok
/*ivm-expect-action rebuild*/

query ITI rowsort
SELECT k, g, v FROM __MV__ WHERE "rowKinds" = 'insert'
