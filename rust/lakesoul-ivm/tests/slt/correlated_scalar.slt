# A new key without rows in the other table does not match.
statement ok
/*ivm-append __SRC__: k=4,g=c,v=50,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, g, v FROM __SRC__ s WHERE v > (SELECT avg(u.v) FROM __DIM__ u WHERE u.k = s.k)

statement ok
/*ivm-expect-action incremental*/

