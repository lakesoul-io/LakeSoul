# A window over a boolean partition and a nullable decimal ordering.

statement ok
/*ivm-append __SRC__: k=1,v=10.5,flag=true,d=12.34,day=1,op=insert; k=2,v=null,flag=true,d=null,day=1,op=insert; k=3,v=3.25,flag=false,d=1.00,day=2,op=insert; k=4,v=7.75,flag=false,d=2.50,day=2,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY flag ORDER BY d DESC, day) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, "row_number" FROM __MV__
----
1 2
2 1
3 2
4 1

# An update reshuffles the descending ranks.
statement ok
/*ivm-append __SRC__: k=4,v=7.75,flag=false,d=0.50,day=2,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY flag ORDER BY d DESC, day) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, "row_number" FROM __MV__
----
1 2
2 1
3 1
4 2

# A delete compresses the ranks.
statement ok
/*ivm-append __SRC__: k=2,v=null,flag=true,d=null,day=1,op=delete*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY flag ORDER BY d DESC, day) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, "row_number" FROM __MV__
----
1 1
3 1
4 2

# A predicate rebuilds the view.
statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY flag ORDER BY d DESC, day) FROM __SRC__ WHERE flag = true

statement ok
/*ivm-expect-action rebuild*/

query II rowsort
SELECT k, "row_number" FROM __MV__
----
1 1

# An incremental row inside the predicate recomputes its partition.
statement ok
/*ivm-append __SRC__: k=5,v=5.0,flag=true,d=5.00,day=2,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY flag ORDER BY d DESC, day) FROM __SRC__ WHERE flag = true

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, "row_number" FROM __MV__
----
1 1
5 2
