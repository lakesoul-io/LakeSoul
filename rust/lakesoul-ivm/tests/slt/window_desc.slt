# A non-default NULL placement is materialized too.
statement ok
/*ivm-append __SRC__: k=5,g=a,v=null,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v DESC NULLS LAST) FROM __SRC__

statement ok
/*ivm-expect-action rebuild*/

query II rowsort
SELECT k, "row_number" FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 2
3 1
4 1
5 3
