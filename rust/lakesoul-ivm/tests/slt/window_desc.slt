# A descending window ordering: ranks follow the value descending.

statement ok
/*ivm-append __SRC__: k=1,g=a,v=10,op=insert; k=2,g=a,v=30,op=insert; k=3,g=a,v=20,op=insert; k=4,g=b,v=5,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v DESC) FROM __SRC__

statement ok
/*ivm-expect-action bootstrap*/

query II rowsort
SELECT k, "row_number" FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 3
2 1
3 2
4 1

# An update reshuffles the descending ranks.
statement ok
/*ivm-append __SRC__: k=3,g=a,v=40,op=insert*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v DESC) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, "row_number" FROM __MV__ WHERE "rowKinds" = 'insert'
----
1 3
2 2
3 1
4 1

# A delete compresses them.
statement ok
/*ivm-append __SRC__: k=2,g=a,v=30,op=delete*/

statement ok
INSERT INTO __MV__ SELECT k, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v DESC) FROM __SRC__

statement ok
/*ivm-expect-action incremental*/

query II rowsort
SELECT k, "row_number" FROM __MV__ WHERE "rowKinds" = 'insert'
