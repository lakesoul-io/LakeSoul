# A filtered step source rebuilds the chain.
statement ok
INSERT INTO __MV__ SELECT a.k, a.g, a.v, b.v AS bv, c.v AS cv FROM __SRC__ a LEFT JOIN __DIM__ b ON b.k = a.k LEFT JOIN (SELECT k, v FROM __DIM2__ WHERE v > 5000) c ON c.k = a.k

statement ok
/*ivm-expect-action rebuild*/

