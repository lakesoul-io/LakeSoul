# A base update keeps the looked-up values; a base delete removes its row.
statement ok
/*ivm-append __SRC__: k=1,g=a,v=11,op=insert; k=3,g=b,v=7,op=insert*/

statement ok
INSERT INTO __MV__ SELECT a.k, a.g, a.v, b.v AS bv, c.v AS cv FROM __SRC__ a LEFT JOIN __DIM__ b ON b.k = a.k LEFT JOIN __DIM2__ c ON c.k = a.k

statement ok
/*ivm-expect-action incremental*/

