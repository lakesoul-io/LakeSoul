          "expr": "histogram_quantile(0.95, sum by (le) (rate(lakesoul_query_planning_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
